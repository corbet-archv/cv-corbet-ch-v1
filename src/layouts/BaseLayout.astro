---
import "../styles/global.css";

interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <slot name="head" />
  </head>
  <body>
    <div class="bg-amber-100 text-amber-900 text-center text-sm py-2 px-4 border-b border-amber-300">
      Archived v1 of cv.corbet.ch — frozen 2026-05-23. Current site at
      <a href="https://cv.corbet.ch" class="underline font-medium">cv.corbet.ch</a>.
    </div>
    <slot />
  </body>
</html>
